# =============================================================================
# PairIt .gitignore
# =============================================================================

# -----------------------------------------------------------------------------
# Node.js / npm
# -----------------------------------------------------------------------------
node_modules/
.npm/

# Lock file is committed so the extension build is reproducible
# package-lock.json  <- intentionally NOT ignored

# -----------------------------------------------------------------------------
# Python
# -----------------------------------------------------------------------------
__pycache__/
*.py[cod]
*.pyo
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Virtual environments
.venv/
venv/
env/
.env/

# Egg / dist info generated by pip install -e .
*.egg-info/
*.egg

# PyPI distribution artifacts (built wheels / sdists)
dist/
build/
out/

# Jupyter / IPython
.ipynb_checkpoints/

# Examples (not part of the package)
examples/

# Test suite (not needed for production)
tests/

# -----------------------------------------------------------------------------
# Chrome Extension
# -----------------------------------------------------------------------------
# WASM binaries — large generated files (~35 MB), excluded from git
extension/stateless/wasm/
# Bundled worker — generated by `npm run build`, excluded from git
extension/stateless/dist/

# Release ZIPs
*.zip

# -----------------------------------------------------------------------------
# Environment variables / secrets
# -----------------------------------------------------------------------------
.env
.env.*
!.env.example
.secret
*.pem
*.key

# -----------------------------------------------------------------------------
# Logs
# -----------------------------------------------------------------------------
*.log
logs/
npm-debug.log*

# -----------------------------------------------------------------------------
# OS generated files
# -----------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini
$RECYCLE.BIN/

# -----------------------------------------------------------------------------
# IDE / Editor
# -----------------------------------------------------------------------------
.vscode/
.idea/

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/
env/
*.egg-info/

# Chrome extension build output
extension/dist/
extension/build/

# Package manager cache
.npm/

# Extension releases
*.zip

# Build tool config (not needed by end users)
esbuild.config.js
package.json
package-lock.json
