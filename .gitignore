# =============================================================================
# PairIt .gitignore
# =============================================================================

# Node.js / npm
node_modules/
.npm/

# Python
__pycache__/
*.py[cod]
*.pyo
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Virtual environments
.venv/
venv/
env/
.env/

# Egg / dist info generated by pip install -e .
*.egg-info/
*.egg

# PyPI distribution artifacts
/dist/
/build/
out/

# Jupyter / IPython
.ipynb_checkpoints/

# Editor-generated temporary example
examples/tempCodeRunnerFile.py

# Generated Chrome extension runtime files
extension/stateless/wasm/
extension/stateless/dist/
extension/dist/
extension/build/

# Release archives
*.zip

# Environment variables and secrets
.env
.env.*
!.env.example
.secret
*.pem
*.key

# Logs
*.log
logs/
npm-debug.log*

# OS-generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini
$RECYCLE.BIN/

# IDEs
.vscode/
.idea/
